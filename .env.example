# Goldie (Cloudflare Pages Function: /api/goldie)
# OpenRouter key for Goldie's AI replies. Server only, never sent to the
# browser; set it in the Cloudflare Pages secret store for production, and
# for local Functions dev pass it at launch as with STRIPE_SECRET_KEY below.
# Obtain a free or pay-as-you-go key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenRouter model (defaults to deepseek/deepseek-chat if not specified)
# Alternatives: meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=

# Google reviews (Cloudflare Pages Function)
# OAuth client ID for the Google Cloud project with the Business Profile API enabled
GOOGLE_OAUTH_CLIENT_ID=
# OAuth client secret for that same Google Cloud project
GOOGLE_OAUTH_CLIENT_SECRET=
# Long-lived refresh token issued to that OAuth client for the clinic's Business Profile
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Business Profile account ID the clinic location sits under
GOOGLE_BUSINESS_ACCOUNT_ID=
# Business Profile location ID for the clinic itself
GOOGLE_BUSINESS_LOCATION_ID=
# Public Google Maps place URL for the "See all on Google" link
GOOGLE_MAPS_PLACE_URL=

# Stripe Checkout (Cloudflare Pages Functions: /api/checkout, /api/checkout-status)
# Production takes the live key and webhook secret; preview takes the test ones.
# Secret key for the Stripe account taking payment. Server only, never sent to
# the browser; set it in the Cloudflare Pages secret store for production.
# For local Functions dev, pass it at launch instead of writing it to a file:
#   npm run dev:functions -- --binding STRIPE_SECRET_KEY=sk_test_...
# That runs Pages Functions on http://localhost:5192, proxying everything that
# is not /api/* to the Vite dev server already running on port 5191.
STRIPE_SECRET_KEY=
# Overrides the origin used for Stripe's success_url/cancel_url. Only needed
# when the request's own origin is wrong for the environment (leave blank in
# production; the live domain is read from the request).
SITE_ORIGIN=
# Signing secret for the Stripe webhook endpoint that calls /api/stripe-webhook
# on the checkout.session.completed event. Copy it from that endpoint's page
# under Developers > Webhooks in the Stripe dashboard; it starts "whsec_".
# Missing: the endpoint returns 503 instead of trusting an unverified request.
STRIPE_WEBHOOK_SECRET=

# Clinic notification emails (Cloudflare Pages Functions: /api/enquiry,
# /api/stripe-webhook), sent via Resend.
# API key for the Resend account sending these emails. Server only, never
# sent to the browser; set it in the Cloudflare Pages secret store for
# production. Obtain a key from https://resend.com/api-keys
# Missing (with either variable below): enquiry.js returns 503, so the
# contact, consultation and training forms fall back to WhatsApp; and
# stripe-webhook.js logs the paid order and skips emailing it, instead of
# failing the webhook.
RESEND_API_KEY=
# The From address on those emails, e.g.
# "MerryGold Beauty Clinic <bookings@merrygoldbeautyclinics.com>". Must be on a
# domain verified in Resend, or every send is rejected.
NOTIFY_FROM_EMAIL=
# Where enquiries and paid orders are sent. Comma-separated for more than one
# recipient, e.g. "hello@merrygoldbeautyclinics.com, someone@gmail.com"
NOTIFY_TO_EMAIL=

# Orders dashboard (Cloudflare Pages Function: /api/orders, page /admin/orders)
# Shared password the dashboard's sign-in form checks against. Missing: the
# endpoint returns 503 ("not switched on yet") instead of a login prompt with
# nothing to check it against.
ORDERS_DASHBOARD_PASSWORD=

# Booking times (Cloudflare Pages Functions: /api/availability, /api/checkout,
# /api/stripe-webhook), read from and written to the clinic's Google Calendar.
# The JSON key of the Google Cloud service account the calendar is shared with
# ("Make changes to events"), pasted whole on one line. Server only; set it in
# the Cloudflare Pages secret store. Missing (with the variable below): the
# checkout cannot list free times, so treatments cannot be booked online, and
# the webhook asks the clinic by email to add each paid booking by hand.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar's id, which for a Google account's main calendar is its email
# address, e.g. merrygoldbeautyclinic@gmail.com
BOOKING_CALENDAR_ID=
